{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Downloader",
  "version": "0.1.0",
  "identifier": "dev.personal.downloader",
  "mainBinaryName": "personal-downloader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Personal Downloader",
        "width": 760,
        "height": 560,
        "minWidth": 560,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
